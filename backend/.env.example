# JWT Secret Key for Authentication
SECRET_KEY=movra_super_secure_jwt_secret_key_2026_dev_env
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini API Key (PhysioAgent & ConsultantAgent)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (TeachingAgent, ScraperAgent, VoiceAgent TTS)
OPENAI_API_KEY=your_openai_api_key_here

# Perplexity API Key (ConsultantAgent market intelligence)
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Contextual AI Configuration (RAGAgent)
CONTEXTUAL_API_KEY=your_contextual_api_key_here
CONTEXTUAL_BASE_URL=https://api.contextual.ai/v1
CONTEXTUAL_AGENT_ID=your_contextual_agent_id_here

# Ollama & Qdrant for LocalRAGAgent
OLLAMA_BASE_URL=http://localhost:11434
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=movra_local_rag

# SQLite Database URL
DATABASE_URL=sqlite:///./movra.db

# Server Port
PORT=8000
